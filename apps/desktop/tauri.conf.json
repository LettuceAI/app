{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LettuceAI",
  "identifier": "com.lettuceai.app",
  "build": {
    "beforeDevCommand": {
      "script": "bun run dev",
      "cwd": "../../frontend"
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "bun run build",
      "cwd": "../../frontend"
    },
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LettuceAI",
        "width": 1440,
        "height": 810,
        "minWidth": 1068,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "homepage": "https://www.lettuceai.app",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
