{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LettuceAI",
  "identifier": "com.lettuceai.app",
  "build": {
    "beforeDevCommand": {
      "script": "bun run dev",
      "cwd": "../ui"
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "bun run build",
      "cwd": "../ui"
    },
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LettuceAI",
        "width": 1440,
        "height": 810,
        "minWidth": 1068,
        "minHeight": 600,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' lettuce-asset: http://lettuce-asset.localhost blob: data: https://image.civitai.com",
        "media-src": "'self' lettuce-asset: http://lettuce-asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost lettuce-asset:",
        "font-src": "'self' data:"
      }
    }
  },
  "bundle": {
    "active": true,
    "homepage": "https://www.lettuceai.app",
    "android": {
      "minSdkVersion": 30
    },
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["lettuce"],
        "name": "LettuceAI backup",
        "mimeType": "application/vnd.lettuceai.backup",
        "role": "Editor"
      },
      {
        "ext": ["uec"],
        "name": "LettuceAI card",
        "mimeType": "application/vnd.lettuceai.uec+json",
        "role": "Editor"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/lettuceai.desktop",
        "files": {
          "/usr/share/mime/packages/com.lettuceai.app.xml": "linux/lettuceai-mime.xml"
        }
      },
      "rpm": {
        "desktopTemplate": "linux/lettuceai.desktop",
        "files": {
          "/usr/share/mime/packages/com.lettuceai.app.xml": "linux/lettuceai-mime.xml"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
