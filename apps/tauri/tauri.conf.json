{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LettuceAI",
  "identifier": "com.lettuceai.app",
  "build": {
    "beforeDevCommand": {
      "script": "bun run dev",
      "cwd": "../ui"
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "bun run build",
      "cwd": "../ui"
    },
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LettuceAI",
        "width": 1440,
        "height": 810,
        "minWidth": 1068,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' lettuce-asset: http://lettuce-asset.localhost blob: data:",
        "media-src": "'self' lettuce-asset: http://lettuce-asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self' data:"
      },
      "devCsp": {
        "default-src": "'self'",
        "img-src": "'self' lettuce-asset: http://lettuce-asset.localhost blob: data:",
        "media-src": "'self' lettuce-asset: http://lettuce-asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1420",
        "font-src": "'self' data:"
      }
    }
  },
  "bundle": {
    "active": true,
    "homepage": "https://www.lettuceai.app",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
