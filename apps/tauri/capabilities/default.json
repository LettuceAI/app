{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window, its desktop title bar controls and the Android back button exit; application commands need no plugin permission.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:app:allow-exit",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://www.lettuceai.app" },
        { "url": "https://www.lettuceai.app/*" },
        { "url": "https://discord.gg/745bEttw2r" },
        { "url": "https://github.com/LettuceAI/app" },
        { "url": "https://github.com/LettuceAI/app/*" }
      ]
    }
  ]
}
