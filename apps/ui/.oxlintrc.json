{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": ["src/api/generated/**", "dist/**"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "regex": "^@tauri-apps/",
            "message": "Only src/api/ may talk to Tauri; use the API client."
          },
          {
            "regex": "^@/features/[^/]+/.+",
            "message": "Import another feature only through its public index: @/features/<name>."
          },
          {
            "regex": "^@/api/generated/",
            "allowTypeImports": true,
            "message": "Only types may come from the generated bindings outside src/api; call the backend through @/api/client."
          },
          {
            "regex": "^@/api/(tauri-transport|mock-transport)",
            "message": "Transports are chosen by @/api/client; nothing outside src/api imports one."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/api/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["src/**/*.test.ts", "src/**/*.test.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@tauri-apps/",
                "message": "Only src/api/ may talk to Tauri; use the API client."
              },
              {
                "regex": "^@/features/[^/]+/.+",
                "message": "Import another feature only through its public index: @/features/<name>."
              },
              {
                "regex": "^@/api/(generated/|tauri-transport)",
                "allowTypeImports": true,
                "message": "Tests drive the UI through the mock transport, never Tauri."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/shared/**", "src/entities/**", "test/lint-fixtures/src/shared/**", "test/lint-fixtures/src/entities/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@tauri-apps/",
                "message": "Only src/api/ may talk to Tauri; use the API client."
              },
              {
                "regex": "^@/features(/|$)",
                "message": "shared/ and entities/ may not import features."
              },
              {
                "regex": "^@/api/generated/",
                "allowTypeImports": true,
                "message": "Only types may come from the generated bindings outside src/api; call the backend through @/api/client."
              },
              {
                "regex": "^@/api/(tauri-transport|mock-transport)",
                "message": "Transports are chosen by @/api/client; nothing outside src/api imports one."
              }
            ]
          }
        ]
      }
    }
  ]
}
